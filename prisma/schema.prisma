generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model InstagramConfig {
  id                String            @id @default(cuid())
  shop              String            @unique
  instagramId       String            @unique  // ID du compte Instagram
  username          String            @unique  // Le pseudo Instagram
  accessToken       String
  tokenExpiresAt    DateTime
  lastRefreshedAt   DateTime?
  isActive          Boolean           @default(true)
  
  // Relations
  posts             InstagramPost[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tokenExpiresAt])
  @@index([isActive])
}

model InstagramPost {
  id                String            @id
  configId          String
  config            InstagramConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  
  // Metadata du post
  shop              String            // Référence implicite pour queries optimisées
  mediaUrl          String
  thumbnailUrl      String?
  permalink         String
  caption           String?
  mediaType         String            // IMAGE, VIDEO, CAROUSEL_ALBUM
  carouselChildren  String?           // JSON string des enfants du carrousel (images et vidéos)
  
  // Ownership tracking (pour les posts taggés de tiers)
  ownerUsername     String?           // Créateur du post si différent de config.username
  
  // Engagement
  likeCount         Int               @default(0)
  commentsCount     Int               @default(0)
  
  // Insights (nullable si pas disponible)
  impressions       Int?
  reach             Int?
  saved             Int?
  
  // Classification
  isTagged          Boolean           @default(false)
  
  // Timestamps
  publishedAt       DateTime          // Quand publié sur Instagram
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([id, configId])
  @@index([configId, publishedAt])
  @@index([configId, likeCount])
  @@index([configId, impressions])
  @@index([configId, isTagged])
}


